{
  "name": "reportes-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "tsx watch src/server.ts --debug",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "test": "vitest run"
  },
  "dependencies": {
