# ==============================================================================
# DONDE VA EL .env
#
# - Instalacion en un cliente (servicio de Windows): en backend\.env, junto a este
#   archivo. Lo crea scripts\instalar-servicio.ps1.
# - Desarrollo (la carpeta del proyecto esta en OneDrive): NO junto al codigo, porque
#   se sincronizaria a la nube con las credenciales. Va en
#       C:\Users\<usuario>\.config\aplicativo-web\.env
#   o en la ruta que indique la variable de entorno APLICATIVO_WEB_ENV.
#
# Si existen los dos, manda el externo (ver src/config/env.ts).
# ==============================================================================

PORT=3000
DB_HOST=localhost
DB_PORT=1433
GENERAL_DB_NAME=GENERAL
DB_USER=sa
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# --- Instalación como servicio y actualizador (ver scripts/LEEME-INSTALACION.md) ---
# NODE_ENV=production lo pone el servicio; con él el backend sirve también el frontend.
# Repositorio público de GitHub (usuario/repositorio) y rama de donde se descargan las versiones
UPDATE_REPO=jesush-redesip/AppReportesFiscales
UPDATE_BRANCH=main
# Nombre del servicio de Windows (lo pone instalar-servicio.ps1)
SERVICE_NAME=ReportesFiscales
# Opcional: token de GitHub de solo lectura, si se llega al límite de 60 consultas/hora
GITHUB_TOKEN=
